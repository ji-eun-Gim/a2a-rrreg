# Agent Card 검증 파이프라인 환경 변수 (.env)
# - 이 파일은 `dotenv` 혹은 `export $(cat .env)` 등으로 로드할 수 있습니다.

# 도메인 화이트리스트 (콤마 구분, 소문자)
AGENT_DOMAIN_WHITELIST=example.com,*.trusted.local,localhost

# IP 화이트리스트 (CIDR 또는 IPv4 단일 주소)
AGENT_IP_WHITELIST=10.0.0.0/8,203.0.113.7

# JWT 검증용 userme 엔드포인트 (docker 환경에서 jwt-server 쓰는 경우 맞게 수정)
USERME_DIRECT_URL=http://host.docker.internal:8000/users/me
JWT_REDIS_URL=redis://host.docker.internal:6380/0
TENANT_API_URL=http://host.docker.internal:8000

# Extension 구조 제약
EXTENSION_MAX_DEPTH=6
EXTENSION_MAX_ARRAY_LENGTH=64
EXTENSION_MAX_NODES=2000

# Agent Card 최대 허용 바이트 (기본 256 KiB)
AGENT_CARD_MAX_BYTES=3000

# 테넌트 목록 (콤마 구분)
SOLUTION_TENANTS=customer-service,logistics
