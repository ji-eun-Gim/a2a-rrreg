# A2A Agent Registry 환경변수 설정 파일

# Redis 접속 정보
# 로컬 Redis 사용 예시(필요 시 주석 해제):
# REDIS_URL=redis://localhost:6379/0

# Flask 실행 환경
# 운영 모드 예시(필요 시 주석 해제):
# FLASK_ENV=production

# 실시간 로그 포워더 설정(선택)
# v3 로그 이벤트를 POST로 전송할 대상 URL (설정 시 포워더 활성화)
LOG_FORWARD_URL=http://host.docker.internal:9000/v3-logs
# 대상 서버에 보낼 Bearer 토큰(선택)
LOG_FORWARD_TOKEN=
# 전송할 op 필터(쉼표로 구분, 예: create,update,delete). 비우면 전체 전송
LOG_FORWARD_OPS=
# 접근 로그(모든 요청) 외부 전송 토글 (0=끄기, 1=켜기)
ACCESS_FORWARD_ENABLED=0
